package mesja;

import java.util.Scanner;

/**
 *
 * @author PAN_CPE113
 */
public class Mesja {

    /**
     * @param args the command line arguments
     */
    
       public class Main {

    // Main method
    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        // Ignore parentheses, commas, and spaces
        // Keep the minus sign for negative validation
        input.useDelimiter("[^0-9-]+");

        // Read two numbers
        // Example: (98,89)
        System.out.print("Enter two numbers (a,b): ");

        int a = input.nextInt();
        int b = input.nextInt();

        // Validate input
        if (a < 0 || b < 0) {

            System.out.println("Invalid Input.");

        } else if (a == 0 && b == 0) {

            System.out.println("Undefined - handle in main()");

        } else {

            int result = gcd(a, b);

            System.out.println("GCD: " + result);
        }

        input.close();
    }

    // Computes GCD recursively using Euclidean algorithm
    public static int gcd(int a, int b) {

        // Base case
        if (b == 0) {
            return a;
        }

        // Recursive case
        return gcd(b, a % b);
    }
}
    }
    